{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Catégories News | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Catégories News ({{ category_news|length }})</h1>
        <p>Gérez les thématiques de vos articles d'actualité.</p>
    </div>
    <a href="{{ path('app_dashboard_category_news_new') }}" class="btn btn-danger">
        <i class="bi bi-plus-circle me-1"></i> Nouvelle Catégorie
    </a>
</div>

<div class="gp-card">
    <div class="table-responsive">
        <table class="table table-gp align-middle">
            <thead>
                <tr>
                    <th width="10%">ID</th>
                    <th>Nom de la thématique</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for cat in category_news %}
                <tr>
                    <td><span class="badge bg-light text-dark">#{{ cat.id }}</span></td>
                    <td class="fw-bold text-danger">{{ cat.name }}</td>
                    <td class="text-end">
                        <div class="btn-group">
                            <a href="{{ path('app_dashboard_category_news_show', {'id': cat.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('app_dashboard_category_news_edit', {'id': cat.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center py-4 text-muted">Aucune catégorie news trouvée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
