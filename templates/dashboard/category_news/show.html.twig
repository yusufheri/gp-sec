{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Catégorie Actualité : {{ category_news.name }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Détails de la Catégorie Actualité</h1>
        <p>Gestion de la classification du blog / actualités.</p>
    </div>
    <div>
        <a href="{{ path('app_dashboard_category_news_index') }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_dashboard_category_news_edit', {'id': category_news.id}) }}" class="btn btn-danger">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="gp-card" style="max-width: 600px;">
    <div class="mb-4">
        <label class="text-muted small d-block">ID de la catégorie</label>
        <span class="badge bg-light text-dark">#{{ category_news.id }}</span>
    </div>
    
    <div class="mb-4">
        <h2 class="fw-bold text-primary">{{ category_news.name }}</h2>
    </div>
    
    <div class="mt-5 pt-3 border-top text-end">
        {{ include('dashboard/category_news/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
