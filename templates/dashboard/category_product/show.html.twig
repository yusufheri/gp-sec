{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Catégorie : {{ category_product.name }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Détails de la Catégorie Produit</h1>
        <p>Gestion de la classification du catalogue.</p>
    </div>
    <div>
        <a href="{{ path('app_dashboard_category_product_index') }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_dashboard_category_product_edit', {'id': category_product.id}) }}" class="btn btn-danger">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="gp-card">
    <div class="mb-4">
        <label class="text-muted small d-block">ID de la catégorie</label>
        <span class="badge bg-light text-dark">#{{ category_product.id }}</span>
    </div>
    
    <div class="mb-4">
        <h2 class="fw-bold text-primary">{{ category_product.name }}</h2>
    </div>

    <div class="p-3 bg-light rounded border mb-4">
        <label class="text-muted small d-block mb-2">Description</label>
        <p class="mb-0">{{ category_product.description|default('Aucune description.') }}</p>
    </div>
    
    <div class="mt-5 pt-3 border-top text-end">
        {{ include('dashboard/category_product/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
