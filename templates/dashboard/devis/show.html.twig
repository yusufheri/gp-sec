{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Détails du Devis #{{ devi.id }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Détails du Devis #{{ devi.id }}</h1>
        <p>Consultation de la demande envoyée par <strong>{{ devi.name }} {{ devi.lastname }}</strong>.</p>
    </div>
    <a href="{{ path('app_dashboard_devis_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="gp-card">
            <h5 class="mb-4 text-primary border-bottom pb-2"><i class="bi bi-info-circle me-2"></i>Informations générales</h5>
            <table class="table table-borderless align-middle">
                <tbody>
                    <tr>
                        <th width="30%" class="text-muted small">ID DEVIS</th>
                        <td><span class="badge bg-light text-dark">#{{ devi.id }}</span></td>
                    </tr>
                    <tr>
                        <th class="text-muted small">DATE RÉCEPTION</th>
                        <td>{{ devi.createdAt ? devi.createdAt|date('d/m/Y à H:i') : 'N/A' }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">CLIENT</th>
                        <td class="fw-bold">{{ devi.name }} {{ devi.lastname }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">ENTREPRISE</th>
                        <td>{{ devi.entreprise|default('N/A') }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">LOCALISATION</th>
                        <td>{{ devi.ville }}, {{ devi.pays ? devi.pays.name : 'N/A' }}</td>
                    </tr>
                </tbody>
            </table>

            <h5 class="mt-5 mb-4 text-primary border-bottom pb-2"><i class="bi bi-chat-left-text me-2"></i>Description du projet</h5>
            <div class="p-3 bg-light rounded border mb-4">
                {{ devi.description|nl2br }}
            </div>

            <div class="d-flex gap-2 pt-3 border-top">
                <a href="mailto:{{ devi.email }}" class="btn btn-danger px-4">
                    <i class="bi bi-reply-fill me-1"></i> Répondre par Email
                </a>
                <a href="tel:{{ devi.telephone }}" class="btn btn-outline-danger px-4">
                    <i class="bi bi-telephone-fill me-1"></i> Appeler le client
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="gp-card">
            <h5 class="mb-4 text-primary border-bottom pb-2"><i class="bi bi-person-lines-fill me-2"></i>Contact</h5>
            <div class="mb-3">
                <label class="text-muted small d-block">Email</label>
                <a href="mailto:{{ devi.email }}" class="text-decoration-none fw-bold">{{ devi.email }}</a>
            </div>
            <div class="mb-3">
                <label class="text-muted small d-block">Téléphone</label>
                <a href="tel:{{ devi.telephone }}" class="text-decoration-none fw-bold">{{ devi.telephone }}</a>
            </div>
            <div class="mb-3">
                <label class="text-muted small d-block">Site Web</label>
                {% if devi.website %}
                    <a href="{{ devi.website }}" target="_blank" class="text-decoration-none">{{ devi.website }}</a>
                {% else %}
                    <span class="text-muted">Aucun site web</span>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
