{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Modifier Actualité | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Modifier l'Actualité</h1>
    <p>Mise à jour de : <strong>{{ news.name }}</strong></p>
</div>

<div class="gp-card">
    {{ include('dashboard/news/_form.html.twig') }}
    
    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_dashboard_news_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
        {{ include('dashboard/news/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
