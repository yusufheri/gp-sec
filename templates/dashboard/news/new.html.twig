{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Nouvelle Actualité | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Publier une Actualité</h1>
    <p>Partagez les dernières informations de GP-SEC.</p>
</div>

<div class="gp-card">
    {{ include('dashboard/news/_form.html.twig') }}
    
    <div class="mt-4">
        <a href="{{ path('app_dashboard_news_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>
</div>
{% endblock %}
