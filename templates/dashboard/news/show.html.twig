{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Article : {{ news.name }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Aperçu de l'Article</h1>
        <p>Visualisation de l'actualité telle qu'elle apparaît sur le site.</p>
    </div>
    <div>
        <a href="{{ path('app_dashboard_news_index') }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_dashboard_news_edit', {'id': news.id}) }}" class="btn btn-danger">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="gp-card">
    <div class="row">
        <div class="col-lg-5">
            {% if news.picture %}
                <img src="{{ asset('media/pictures/'~news.picture) }}" class="img-fluid rounded shadow-sm mb-3 w-100" style="max-height: 400px; object-fit: cover;" alt="{{ news.name }}">
            {% else %}
                <div class="bg-light rounded mb-3 d-flex align-items-center justify-content-center" style="height: 300px;"><i class="bi bi-image text-muted display-1"></i></div>
            {% endif %}
            
            <div class="p-3 bg-light rounded">
                <div class="mb-2">
                    <span class="text-muted small d-block">Date de publication</span>
                    <span class="fw-bold"><i class="bi bi-calendar-event me-1"></i> {{ news.publiedAt ? news.publiedAt|date('d/m/Y à H:i') : 'Non publié' }}</span>
                </div>
                <div>
                    <span class="text-muted small d-block">Dernière modification</span>
                    <span class="text-muted small">{{ news.updatedAt ? news.updatedAt|date('d/m/Y à H:i') : 'N/A' }}</span>
                </div>
            </div>
        </div>
        
        <div class="col-lg-7">
            <h2 class="fw-bold mb-4 text-primary">{{ news.name }}</h2>
            <div class="content-text border-top pt-4">
                {{ news.description|raw }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
