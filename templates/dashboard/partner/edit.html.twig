{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Modifier Partenaire | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Modifier le Partenaire</h1>
    <p>Mise à jour pour : <strong>{{ partner.name }}</strong></p>
</div>

<div class="gp-card">
    {{ include('dashboard/partner/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
    
    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_dashboard_partner_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
        {{ include('dashboard/partner/_delete_form.html.twig') }}
    </div>
{% endblock %}
