{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Partenaire : {{ partner.name }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Détails du Partenaire</h1>
        <p>Aperçu des informations de collaboration.</p>
    </div>
    <div>
        <a href="{{ path('app_dashboard_partner_index') }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_dashboard_partner_edit', {'id': partner.id}) }}" class="btn btn-danger">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="gp-card">
    <div class="row align-items-center">
        <div class="col-lg-4 text-center">
            {% if partner.picture %}
                <img src="{{ asset('media/pictures/'~partner.picture) }}" class="img-fluid rounded shadow-sm mb-3" style="max-height: 200px; object-fit: contain; background: #f8f9fa; padding: 20px;" alt="{{ partner.name }}">
            {% else %}
                <div class="bg-light rounded mb-3 d-flex align-items-center justify-content-center mx-auto" style="width: 200px; height: 150px;"><i class="bi bi-people text-muted display-1"></i></div>
            {% endif %}
            <h4 class="fw-bold">{{ partner.name }}</h4>
        </div>
        <div class="col-lg-8">
            <h5 class="text-primary border-bottom pb-2">Description / Notes</h5>
            <div class="p-3 bg-light rounded mb-4">
                <p class="mb-0 text-muted">{{ partner.description|default('Aucune description fournie.') }}</p>
            </div>
            
            <div class="small text-muted">
                <span class="me-3">ID: #{{ partner.id }}</span>
                <span>Dernière mise à jour : {{ partner.updatedAt ? partner.updatedAt|date('d/m/Y à H:i') : 'N/A' }}</span>
            </div>
            
            <div class="mt-4 pt-3 border-top">
                {{ include('dashboard/partner/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
