{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Nouveau Pays | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Ajouter un Pays</h1>
    <p>Enregistrez un nouveau pays dans la base de données.</p>
</div>

<div class="gp-card">
    {{ include('dashboard/pays/_form.html.twig') }}
    
    <div class="mt-4">
        <a href="{{ path('app_dashboard_pays_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>
</div>
{% endblock %}
