{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Pays : {{ pay.name }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Détails du Pays</h1>
        <p>Consultation du pays enregistré dans le système.</p>
    </div>
    <div>
        <a href="{{ path('app_dashboard_pays_index') }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_dashboard_pays_edit', {'id': pay.id}) }}" class="btn btn-danger">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="gp-card" style="max-width: 600px;">
    <table class="table table-gp align-middle">
        <tbody>
            <tr>
                <th width="30%" class="text-muted small">ID</th>
                <td><span class="badge bg-light text-dark">#{{ pay.id }}</span></td>
            </tr>
            <tr>
                <th class="text-muted small">NOM DU PAYS</th>
                <td class="fw-bold fs-5 text-primary">{{ pay.name }}</td>
            </tr>
        </tbody>
    </table>
    
    <div class="mt-4 pt-3 border-top text-end">
        {{ include('dashboard/pays/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
