{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Gestion des Produits | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-table-card">
    <div class="dashboard-table-card__header">
        <h2><i class="bi bi-box-seam me-2"></i> Catalogue Produits</h2>
        <a href="{{ path('app_dashboard_product_new') }}" class="btn btn-danger btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Nouveau Produit
        </a>
    </div>
    <div class="dashboard-table-card__body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Produit</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for product in products %}
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-box text-danger" style="font-size: 1.25rem;"></i>
                                </div>
                                <div class="fw-bold text-dark">{{ product.name }}</div>
                            </div>
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="{{ path('app_dashboard_product_show', {'id': product.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_dashboard_product_edit', {'id': product.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center py-5">
                            <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-muted">Le catalogue est vide.</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
