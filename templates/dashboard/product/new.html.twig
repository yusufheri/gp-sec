{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Nouveau Produit | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Ajouter un nouveau produit</h1>
    <p>Remplissez les informations ci-dessous pour ajouter un produit au catalogue.</p>
</div>

<div class="gp-card">
    {{ include('dashboard/product/_form.html.twig') }}
    
    <div class="mt-4">
        <a href="{{ path('app_dashboard_product_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>
</div>
{% endblock %}
