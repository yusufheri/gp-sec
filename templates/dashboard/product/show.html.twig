{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Produit : {{ product.name }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Fiche Produit : {{ product.name }}</h1>
        <p>Aperçu complet des informations du produit enregistré dans le catalogue.</p>
    </div>
    <div>
        <a href="{{ path('app_dashboard_product_index') }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_dashboard_product_edit', {'id': product.id}) }}" class="btn btn-danger">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="gp-card text-center">
            {% if product.picture %}
                <img src="{{ asset('media/pictures/'~product.picture) }}" class="img-fluid rounded shadow-sm mb-3" style="max-height: 300px; object-fit: contain;" alt="{{ product.name }}">
            {% else %}
                <div class="bg-light rounded mb-3 d-flex align-items-center justify-content-center" style="height: 200px;"><i class="bi bi-image text-muted display-1"></i></div>
            {% endif %}
            <h4 class="fw-bold">{{ product.name }}</h4>
            <div class="text-danger fs-3 fw-bold mb-3">{{ product.price|number_format(2, ',', ' ') }} $</div>
            <div class="d-flex justify-content-center gap-2 mb-3">
                {% for i in 1..5 %}
                    <i class="bi bi-star-fill {{ i <= product.rating ? 'text-warning' : 'text-muted' }}"></i>
                {% endfor %}
            </div>
            <span class="badge bg-light text-dark border">ID: #{{ product.id }}</span>
        </div>
    </div>
    
    <div class="col-lg-8">
        <div class="gp-card">
            <h5 class="mb-4 text-primary border-bottom pb-2">Description Courte</h5>
            <p class="text-muted">{{ product.smallDescription }}</p>

            <h5 class="mt-5 mb-4 text-primary border-bottom pb-2">Description Détaillée</h5>
            <div class="content-text">
                {{ product.description|raw }}
            </div>

            <h5 class="mt-5 mb-4 text-primary border-bottom pb-2">Documents & Médias</h5>
            <div class="d-flex gap-3">
                {% if product.brochure %}
                    <a href="{{ asset('media/brochures/'~product.brochure) }}" target="_blank" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Voir la Brochure
                    </a>
                {% endif %}
                <span class="text-muted small align-self-center">Dernière mise à jour : {{ product.updatedAt ? product.updatedAt|date('d/m/Y à H:i') : 'N/A' }}</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
