{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Modifier Service | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Modifier le Service</h1>
    <p>Mise à jour des informations pour : <strong>{{ service.name }}</strong></p>
</div>

<div class="gp-card">
    {{ include('dashboard/service/_form.html.twig') }}
    
    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_dashboard_service_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
        {{ include('dashboard/service/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
