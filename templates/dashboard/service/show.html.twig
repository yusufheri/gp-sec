{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Service : {{ service.name }} | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Détails du Service</h1>
        <p>Aperçu des informations pour la prestation de service.</p>
    </div>
    <div>
        <a href="{{ path('app_dashboard_service_index') }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_dashboard_service_edit', {'id': service.id}) }}" class="btn btn-danger">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="gp-card">
    <div class="row align-items-center">
        <div class="col-lg-4 text-center">
            {% if service.picture %}
                <img src="{{ asset('media/pictures/'~service.picture) }}" class="img-fluid rounded shadow me-3" style="max-height: 250px; object-fit: cover;" alt="{{ service.name }}">
            {% else %}
                <div class="bg-light rounded mb-3 d-flex align-items-center justify-content-center" style="height: 200px;"><i class="bi bi-gear-wide-connected text-muted display-1"></i></div>
            {% endif %}
        </div>
        <div class="col-lg-8">
            <h2 class="fw-bold text-primary mb-3">{{ service.name }}</h2>
            <div class="p-3 bg-light rounded mb-4">
                <p class="mb-0 text-muted">{{ service.description }}</p>
            </div>
            <div class="small text-muted">
                <i class="bi bi-clock me-1"></i> Dernière mise à jour : {{ service.updatedAt ? service.updatedAt|date('d/m/Y à H:i') : 'N/A' }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
