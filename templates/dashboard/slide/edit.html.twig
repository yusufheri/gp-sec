{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Modifier Slide | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Modifier le Slide</h1>
    <p>Mise à jour pour : <strong>{{ slide.title }}</strong></p>
</div>

<div class="gp-card">
    {{ include('dashboard/slide/_form.html.twig') }}
    
    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_dashboard_slide_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
        {{ include('dashboard/slide/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
