{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Modifier Témoignage | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header">
    <h1>Modifier le Témoignage</h1>
    <p>Mise à jour pour : <strong>{{ testimonial.name }}</strong></p>
</div>

<div class="gp-card">
    {{ include('dashboard/testimonial/_form.html.twig') }}
    
    <div class="mt-4 d-flex justify-content-between">
        <a href="{{ path('app_dashboard_testimonial_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
        {{ include('dashboard/testimonial/_delete_form.html.twig') }}
    </div>
{% endblock %}
