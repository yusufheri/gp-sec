{% extends 'dashboard/dashboard_base.html.twig' %}

{% block title %}Témoignages | GP-SEC{% endblock %}

{% block dashboard_body %}
<div class="dashboard-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Témoignages Clients ({{ testimonials|length }})</h1>
        <p>Gérez les retours et avis de vos clients pour les afficher sur le site.</p>
    </div>
    <a href="{{ path('app_dashboard_testimonial_new') }}" class="btn btn-danger">
        <i class="bi bi-plus-circle me-1"></i> Nouveau Témoignage
    </a>
</div>

<div class="gp-card">
    <div class="table-responsive">
        <table class="table table-gp align-middle">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Poste / Grade</th>
                    <th>Message</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for testimonial in testimonials %}
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            {% if testimonial.picture %}
                                <img src="{{ asset('media/pictures/'~testimonial.picture )|imagine_filter('my_thumb') }}" class="rounded-circle shadow-sm me-3" style="width: 45px; height: 45px; object-fit: cover;" alt="{{ testimonial.name }}">
                            {% else %}
                                <div class="bg-light rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;"><i class="bi bi-person text-muted"></i></div>
                            {% endif %}
                            <div class="fw-bold">{{ testimonial.name }}</div>
                        </div>
                    </td>
                    <td><span class="badge bg-info text-dark">{{ testimonial.grade }}</span></td>
                    <td class="text-muted"><small>{{ testimonial.description|extractText(80) }}</small></td>
                    <td class="text-end">
                        <div class="btn-group">
                            <a href="{{ path('app_dashboard_testimonial_show', {'id': testimonial.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('app_dashboard_testimonial_edit', {'id': testimonial.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center py-4 text-muted">Aucun témoignage trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
