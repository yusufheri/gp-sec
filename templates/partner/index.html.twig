{% extends 'base.html.twig' %}

{% block title %}Nos Clients & Partenaires{% endblock %}

{% block body %}
<!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
      <div class="container">

        <ol>
          <li><a href="{{ path('app_home') }}">Page d'accueil</a></li>
          <li>Clients</li>
        </ol>
        <h2>Nos Clients & Partenaires</h2>

      </div>
    </section><!-- End Breadcrumbs -->

     <!-- ======= Partners Section ======= -->
    <section id="services" class="services">
      <div class="container">

        <div class="section-title" data-aos="fade-up">
          <h2>Ils nous font confiance</h2>
          <p>Découvrez les institutions et entreprises qui ont choisi <span>GP-SEC</span> pour leur sécurité et leurs services technologiques.</p>
        </div>

        <div class="row">
          
          {% for partner in p %}
              <div class="col-lg-4 col-md-6 col-sm-6 d-flex align-items-stretch mt-4" data-aos="zoom-in" data-aos-delay="{{ loop.index0 * 50 }}">
                <div class="icon-box partner-card">
                  <div class="partner-card__logo">
                     {% if partner.picture %}
                        <img src="{{ asset('media/pictures/'~partner.picture) }}" class="partner-card__img" alt="{{ partner.name }}">
                     {% else %}
                        <div class="partner-card__placeholder">
                           <i class="bi bi-building"></i>
                        </div>
                     {% endif %}
                  </div>
                  <h4><a href="javascript:void(0)">{{ partner.name }}</a></h4>
                  <p class="justify-text">{{ partner.description }}</p>
                </div>
              </div>
          {% endfor %}

        </div>

      </div>
    </section><!-- End Partners Section -->
{% endblock %}
